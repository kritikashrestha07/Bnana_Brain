# Banana Brain — Server Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banana_brain
DB_USER=postgres
DB_PASSWORD=shxtouorshottom

# Session
SESSION_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars

# CORS — set to your frontend origin
CLIENT_ORIGIN=http://localhost:5173

# Banana API
BANANA_API_BASE_URL=http://marcconrad.com/uob/banana/api.php
BANANA_API_TIMEOUT_MS=8000

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

